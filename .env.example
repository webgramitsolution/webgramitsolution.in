# Hostinger MySQL. Hostinger database setup can inject these automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional: existing Supabase Auth user UUID to grant administrator access.
DB_ADMIN_USER_ID=

# Supabase Auth public settings. Set Vite values before building.
# Supabase holds login accounts. MySQL holds application data and admin access.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Verify any additional VITE_ keys required by the current Supabase project.
VITE_SUPABASE_PROJECT_ID=

# Hostinger mailbox. Keep SMTP credentials server-side.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@webgramitsolution.in
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@webgramitsolution.in
ENQUIRY_INBOX=info@webgramitsolution.in

# Optional HTTPS automation endpoint. Keep the URL server-side.
ENQUIRY_CRM_WEBHOOK_URL=
